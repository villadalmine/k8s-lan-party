     },
     "confirm": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "the token of the plan, single use, 60 s"
     },
     "typed": {
      "type": "string",
      "maxLength": 20,
      "description": "for type:name the name, for type:all the word all"
     }
    }
   },
   "Plan": {
    "type": "object",
    "properties": {
     "verb": {
      "$ref": "#/components/schemas/Verb"
     },
     "args": {
      "type": "object"
     },
     "will": {
      "type": "array",
      "items": {
       "type": "string"
      },

      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "Job": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "verb": {
      "$ref": "#/components/schemas/Verb"
     },
     "state": {
      "enum": [
       "running",
       "done",
       "failed",
       "timeout"
      ]
     },
     "exit": {
      "type": [
       "integer",
       "null"
      ],
      "description": "the engine's own exit code; 124 after the timeout killed the process group"
     },
     "output": {
      "type": "string",
      "description": "stdout and stderr, redacted, at most 64 KiB"
     },
     "started": {
      "type": "integer"
     },
     "ended": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  },

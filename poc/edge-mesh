#!/bin/sh
# edge-mesh: the participant-side command. POSIX sh, runs on the joining machine (here: inside a container).
#   edge-mesh join <bundle-dir> [--accept-golden-rule]
#   edge-mesh kubectl <kubectl arguments...>    kubectl with your own kubeconfig (KUBECONFIG, default /etc/edge-mesh/kubeconfig, which
#                                               `join` installs from the bundle), over Nebula, with the error matrix's messages
#                                               (docs/DESIGN.md section 14.1). Exit codes: kubectl's own, or
#                                               10 Nebula is down (row 6)        11 the API's certificate does not match the bundle (row 7)
#                                               12 401: the token ended with the lease (row 8)   13 403: outside your namespace (row 9)
#                                               14 exceeded quota (row 11)
# The bundle holds: ca.crt host.crt host.key config.yml join.env (K3S_URL, K3S_TOKEN, NODE_NAME, NODE_IP, TRUST) and kubeconfig (the user's).
set -eu
cmd="${1:-}"; bundle="${2:-}"; accept="${3:-}"
case "$cmd" in
  join)
    [ -d "$bundle" ] || { echo "usage: edge-mesh join <bundle-dir> --accept-golden-rule"; exit 2; }
    echo "Golden rule: what runs on someone else's machine can be seen by its owner."
    [ "$accept" = "--accept-golden-rule" ] || { echo "refusing to join: golden rule not accepted"; exit 3; }
    . "$bundle/join.env"
    [ "$(id -u)" = 0 ] || { echo "refusing to join: run as root (sudo edge-mesh join ...): Nebula and k3s need to create a network device and mounts"; exit 6; }
    [ -c /dev/net/tun ] || { echo "refusing to join: no /dev/net/tun (needs a privileged Linux: VM, privileged Docker or WSL2)"; exit 4; }
    mkdir -p /etc/nebula; cp "$bundle/ca.crt" "$bundle/host.crt" "$bundle/host.key" "$bundle/config.yml" /etc/nebula/
    nohup /opt/nebula/nebula -config /etc/nebula/config.yml >/var/log/nebula.log 2>&1 &
    i=0; until ping -c1 -W1 "$LH_NEB" >/dev/null 2>&1; do i=$((i+1)); [ $i -gt 30 ] && { echo "nebula: cannot reach the lighthouse. UDP 4242 to it must be allowed (corporate firewall?); ask for the relay option"; exit 5; }; sleep 1; done
    # host TCP over the Cilium WireGuard: keep the MSS under the WireGuard device MTU (docs/TROUBLESHOOTING.md, "mutual auth stalls")
    [ "${CNI:-flannel}" = cilium ] && ip route replace "${LH_NEB%.*}.0/24" dev nebula1 scope link advmss "${HOST_MSS:-860}"
    # the k3s token travels over TLS with the CA pinned (K10<hash>...) and only inside the Nebula tunnel
    cni_flags="--flannel-iface nebula1"
    if [ "${CNI:-flannel}" = cilium ]; then
      # the server runs flannel-less (the agent has no such flag): k3s then leaves containerd on its defaults (/etc/cni/net.d, /opt/cni/bin) where Cilium writes; keep the
      # k3s bundled plugins (loopback) on the search path too
      cni_flags=""
      d=/var/lib/rancher/k3s/agent/etc/containerd/config-v3.toml.d; mkdir -p "$d"
      printf "[plugins.'io.containerd.cri.v1.runtime'.cni]
  conf_dir = '/etc/cni/net.d'
  bin_dirs = ['/opt/cni/bin', '/var/lib/rancher/k3s/data/cni']
" >"$d/10-cni.toml"
    fi
    taint=""; [ "${TAINT:-no}" = yes ] && taint="--node-taint trust=$TRUST:NoSchedule"
    # the node password the host made for this name (only this bundle has it): k3s registers this name only with it
    if [ -n "${NODE_PASSWORD:-}" ]; then mkdir -p /etc/rancher/node && (umask 077 && printf '%s' "$NODE_PASSWORD" >/etc/rancher/node/password); fi
    # shellcheck disable=SC2086
    # supervised: if the agent dies it starts again, like a Deployment would. Measured 2026-10-26: when the tunnel drops, nebula1 loses its address and the
    # embedded flannel (v0.28.4, vxlan reCreateVxlan) panics with "index out of range"; unsupervised, the node stays NotReady for ever after the network is back.
    # A restart needs no valid token: the agent reuses the credentials it stored at the first join (tested with a bogus token).
    nohup sh -c 'while :; do k3s agent "$@"; echo "k3s agent exited with $?, starting it again in 5 s"; sleep 5; done' sh \
      --server "$K3S_URL" --token "$K3S_TOKEN" --node-name "$NODE_NAME" --node-ip "$NODE_IP" $cni_flags $taint >/var/log/k3s-agent.log 2>&1 &
    sup=$!
    giveup() { kill "$sup" 2>/dev/null; pkill -f "k3s agent" 2>/dev/null; echo "$1"; exit 7; }   # no supervisor left looping behind a failed join
    # the agent registers within seconds; a rejected token (burned by the host once a node registered with it, or expired: it lives 8 minutes at most) is only visible in its log, so look for it
    i=0; until [ -f /var/lib/rancher/k3s/agent/client-kubelet.crt ]; do
      i=$((i+1)); grep -q "not authorized" /var/log/k3s-agent.log 2>/dev/null && [ $i -gt 15 ] && giveup "refusing to stay: the control plane rejected the join token (already used by a node, or expired: it lives 8 minutes at most). Ask the host for a new invite."
      grep -qi "password rejected" /var/log/k3s-agent.log 2>/dev/null && [ $i -gt 15 ] && giveup "refusing to stay: the control plane refused this node name with this bundle's node password. Ask the host for a new invite."
      [ $i -gt 90 ] && giveup "the node did not register within 90 s: see /var/log/k3s-agent.log"; sleep 1
    done
    echo "joined: $NODE_NAME (trust=$TRUST)"
    # the user's credential, apart from the node's: a token for the namespace play-<name> only, valid until the lease ends
    if [ -f "$bundle/kubeconfig" ]; then
      mkdir -p /etc/edge-mesh && (umask 077 && cp "$bundle/kubeconfig" /etc/edge-mesh/kubeconfig.new) && mv /etc/edge-mesh/kubeconfig.new /etc/edge-mesh/kubeconfig
      echo "your namespace: play-$NODE_NAME; try: sudo edge-mesh kubectl get pods"
    fi
    ;;
  kubectl)
    shift
    kc="${KUBECONFIG:-/etc/edge-mesh/kubeconfig}"
    [ -r "$kc" ] || { echo "edge-mesh: no kubeconfig at $kc: join first (sudo edge-mesh join <bundle-dir> --accept-golden-rule) or set KUBECONFIG" >&2; exit 2; }
    ns=$(sed -n 's/^ *namespace: *//p' "$kc" | head -n1)
    # row 6: the API lives only on the control plane's Nebula address, so without the tunnel kubectl would only time out
    ip -4 addr show dev nebula1 2>/dev/null | grep -q inet || {
      echo "edge-mesh: Nebula is down (nebula1 has no address), so the cluster cannot be reached; run: sudo edge-mesh join <bundle-dir> --accept-golden-rule" >&2; exit 10; }
    if command -v kubectl >/dev/null 2>&1; then set -- kubectl "$@"; else set -- k3s kubectl "$@"; fi
    err=$(mktemp); trap 'rm -f "$err"' EXIT
    rc=0; KUBECONFIG="$kc" "$@" 2>"$err" || rc=$?
    cat "$err" >&2
    [ "$rc" -ne 0 ] || exit 0
    if grep -q 'x509:' "$err"; then
      echo "edge-mesh: the API's certificate is not the one your bundle pins (x509): a wrong or old bundle, or a man in the middle; download your bundle again" >&2; exit 11
    elif grep -qE 'Unauthorized|must be logged in' "$err"; then
      echo "edge-mesh: 401 Unauthorized: your access ended with your lease (or the host ended it); to play again, ask for a new place" >&2; exit 12
    elif grep -q 'exceeded quota' "$err"; then
      echo "edge-mesh: exceeded quota in $ns: lower the requests or delete something (see: edge-mesh kubectl describe quota)" >&2; exit 14
    elif grep -qE 'cannot [a-z]+ resource' "$err"; then
      echo "edge-mesh: forbidden (403): you may only work in your namespace $ns" >&2; exit 13
    fi
    exit "$rc" ;;
  *) echo "usage: edge-mesh join <bundle-dir> --accept-golden-rule | edge-mesh kubectl <arguments>"; exit 2 ;;
esac

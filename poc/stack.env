# Pinned versions for the PoC (looked up live on 2026-10-16). Change here, nowhere else.
NEBULA_VERSION=1.11.2
K3S_IMAGE=rancher/k3s:v1.37.1-k3s1
HELM_IMAGE=alpine/helm:4.3.1
HELM_VERSION=4.3.1
K3S_VERSION=v1.37.1+k3s1
CILIUM_VERSION=1.20.3
KYVERNO_VERSION=1.19.1
# Addressing
DOCKER_NET=emesh
# the fixed container names of the Docker flow, and the sidecars that share n2's namespace (so they are not on the network): down.sh, any_machines and
# docker_clean read this one list (the players, whatever their name, are found by the network)
GAME_CONTAINERS="lh cp n1 n2 fwl htl"
DOCKER_SUBNET=172.31.0.0/24
LH_DOCKER_IP=${LH_DOCKER_IP:-172.31.0.2}  # the lighthouse's real (underlay) address: the VM flow overrides it
# The underlay of the VM flow (Incus): the network the machines reach each other on before Nebula. Change it to run a second game on the same host
# (together with INCUS_PROJECT and VMNET, see HOST-YOUR-OWN.md).
UNDERLAY_NET=${UNDERLAY_NET:-10.78.0}
LH_NEB=10.77.0.1
CP_NEB=10.77.0.2
N1_NEB=10.77.0.3
N2_NEB=10.77.0.4
MESH_CIDR=${LH_NEB%.*}.0/24   # the game's Nebula subnet: issue.sh signs every host as <ip>/24 (cilium-node-guard.yaml bounds InternalIPs to it)
# MTU, set once (issue #8): the Nebula interface MTU is the only number; the pod MTU is derived from it. Cilium's tunnel (VXLAN, 50) and its
# WireGuard (80 in the worst case, IPv6 outer header) sit between them; round down to a multiple of 50: 1300 -> 1150.
NEBULA_MTU=1300
pod_mtu_from() { echo $(( ($1 - 50 - 80) / 50 * 50 )); }   # the one formula; checks-cilium.sh applies it to the MTU it measures
POD_MTU=$(pod_mtu_from "$NEBULA_MTU")
TOOLS_IMAGE=alpine/k8s:1.37.1
# step 2: packet capture on the node's own network namespace (the k3s and Cilium images ship no tcpdump)
NETSHOOT_IMAGE=nicolaka/netshoot:v0.16
KYVERNO_CHART=3.9.1
# a workload that does nothing, runs as non-root and passes Pod Security "restricted" (make poc-pool; looked up live on 2026-10-28)
PAUSE_IMAGE=registry.k8s.io/pause:3.10.2
# a small server and client for the network checks (agnhost netexec / connect), the same restricted profile (make poc-pool; looked up live on 2026-10-28)
AGNHOST_IMAGE=registry.k8s.io/e2e-test-images/agnhost:2.66.1
# join by signed PR (poc/participants.py, make poc-participants; looked up live on 2026-10-28). cosign is checked against its release's
# cosign_checksums.txt; age publishes no checksum file, so its tarballs are pinned here.
COSIGN_VERSION=3.1.4
AGE_VERSION=1.3.2
AGE_SHA256_AMD64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
AGE_SHA256_ARM64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4
# the refusal test of a joiner without /dev/net/tun (tests/test_join_refusal.py): a plain container
ALPINE_IMAGE=alpine:3.24.3
# Issue #13: the maintainer's endpoints. Gateway and TLS on own nodes only, BGP from own nodes only (looked up live on 2026-10-28)
CERT_MANAGER_VERSION=v1.21.3
ENVOY_GATEWAY_VERSION=v1.9.3
# The test router (FRR, an Incus container on the underlay; never the real edge router), the ASNs (private range) and the LoadBalancer pool
ROUTER_IP=${ROUTER_IP:-$UNDERLAY_NET.20}
ROUTER_ASN=${ROUTER_ASN:-64512}
OWN_ASN=${OWN_ASN:-64513}
LB_POOL_CIDR=${LB_POOL_CIDR:-10.200.0.0/28}
GW_HOST=gateway.lan-party.test
FRR_IMAGE=${FRR_IMAGE:-images:debian/13}
# make regression REGRESSION_RUNTIME=docker-vm (issue #62): the Docker and kind suites in an Ubuntu VM of the run's own Incus project
# (poc/vm/docker-vm.sh; looked up live on 2026-11-03: docker.io in noble-updates, kind's latest release, kubectl stable). The kind node image
# is kind-cilium.sh's KIND_NODE_IMAGE (kindest/node:v1.37.0, listed in kind v0.33.0's release notes).
DOCKER_APT_VERSION=29.1.3-0ubuntu3~24.04.2
KIND_VERSION=0.33.0
KUBECTL_VERSION=v1.37.2
# their SHA-256, pinned like AGE_SHA256_* (read from each release's published sum files on 2026-11-03): a re-uploaded asset fails the check
KIND_SHA256_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
KUBECTL_SHA256_AMD64=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4
KUBECTL_SHA256_ARM64=fcc16f63186659d9722014b7e02d5fdd2d4e669cb8c0ab66365d7d3b8ba03509
HELM_SHA256_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
HELM_SHA256_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
DVM_IMAGE=${DVM_IMAGE:-images:ubuntu/24.04/cloud}

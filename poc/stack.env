# Pinned versions for the PoC (looked up live on 2026-10-16). Change here, nowhere else.
NEBULA_VERSION=1.11.2
K3S_IMAGE=rancher/k3s:v1.37.1-k3s1
HELM_IMAGE=alpine/helm:4.3.1
HELM_VERSION=4.3.1
K3S_VERSION=v1.37.1+k3s1
CILIUM_VERSION=1.20.3
KYVERNO_VERSION=1.19.1
# Addressing
DOCKER_NET=emesh
DOCKER_SUBNET=172.31.0.0/24
LH_DOCKER_IP=${LH_DOCKER_IP:-172.31.0.2}  # the lighthouse's real (underlay) address: the VM flow overrides it
# The underlay of the VM flow (Incus): the network the machines reach each other on before Nebula. Change it to run a second game on the same host
# (together with INCUS_PROJECT and VMNET, see HOST-YOUR-OWN.md).
UNDERLAY_NET=${UNDERLAY_NET:-10.78.0}
LH_NEB=10.77.0.1
CP_NEB=10.77.0.2
N1_NEB=10.77.0.3
N2_NEB=10.77.0.4
# Nebula MTU 1300 - VXLAN 50 - WireGuard 60 = 1190; round down
POD_MTU=1150
TOOLS_IMAGE=alpine/k8s:1.37.1
# step 2: packet capture on the node's own network namespace (the k3s and Cilium images ship no tcpdump)
NETSHOOT_IMAGE=nicolaka/netshoot:v0.16
KYVERNO_CHART=3.9.1
# a workload that does nothing, runs as non-root and passes Pod Security "restricted" (make poc-pool; looked up live on 2026-10-28)
PAUSE_IMAGE=registry.k8s.io/pause:3.10.2
# a small server and client for the network checks (agnhost netexec / connect), the same restricted profile (make poc-pool; looked up live on 2026-10-28)
AGNHOST_IMAGE=registry.k8s.io/e2e-test-images/agnhost:2.66.1

#!/usr/bin/env bash
# mesh: the host's command line. Thin, deterministic wrappers over nebula-cert, nebula, k3s and kubectl.
#   mesh host init                         open your game: CA, lighthouse, control plane (API only on the Nebula IP)
#   mesh host invite <name> [--ttl 2h] [--trust friends|public] [--pub FILE]   a bundle for one player (cert + config + a join token of 8 min at most)
#                                          and their namespace play-<name> with a kubeconfig valid for the ttl (at least 11m; poc/participant.py)
#   mesh host players [--json --read-only]  who is in: node, Ready, certificate time left (and burns the join token of every registered node;
#                                          --read-only burns nothing and leaves the node guard alone: the host console's read)
#   mesh host burn                         delete the join token of every registered player (a k3s token is not one-time) and refresh the node guard (prints burned N)
#   mesh host revoke <name>                the one command: blocklist the certificate on every host, reload, delete the node (idempotent; exit 5 = done everywhere but the external lighthouse could not be updated)
#   mesh host kick <name>                  the player's API token dies, cordon, drain, revoke, remove the machine, delete play-<name>
#   mesh host activity <name>              "active" (Ready, with a workload) or "idle: <why>" (exit 1): what the tick's idle kick reads
#   mesh host refresh <name>               rewrite the Nebula config of a running machine (lh, cp or a player; same certificate) and apply it
#   mesh host down                         end the game: remove everything
#   mesh play <name>                       (local simulation only) a player machine joins with "edge-mesh join"
# Admission with manual approval (docs/ADMISSION.md; the numbers are in pool.yaml, or POOL_CONFIG=<file>):
#   mesh host request <name> [--ip IP] [--note "text"]   put someone on the waiting list; prints the position, or when they become eligible
#   mesh host waitlist                     the list, in order (waiting = eligible now, deferred = cooldown or daily cap)
#   mesh host approve [<name>] [--trust public|friends]  the named one, or the first eligible: checks places and limits, invites
#                                          with ttl = the lease (the join token: TOKEN_TTL, 8 min at most), records the lease
#   mesh host reject <name> [--reason "text"]           take a request off the list
#   mesh host leases                       active leases and the time left
#   mesh host reap [--all | --name N]      burn, then kick every lease that ended (or all / one now) and free its place; again: "reaped 0"
#   mesh host admission-status             one line: places used, waiting, next to end
# The automatic pool (phase B1, docs/ADMISSION.md); the host's timer runs the tick, there is no loop of its own:
#   mesh host auto --once                  one tick: burn, expel what ended or idles (always), warn at 5 min, and with auto on approve the first
#                                          eligible ones while a place is free (public bundle into the outbox); idempotent
#   mesh host auto on|off|status           the switch (state: admission/auto.json; off by default)
#   mesh host panic [--clear]              the abuse switch: auto off, effective slots 0, every active lease expelled; --clear reopens
#   mesh host bundle <name>                the approved bundle as admission/outbox/<name>.tar.gz (0600) and the one-line join command
#   mesh host admission-metrics            Prometheus textfile metrics (no identities)
#   events: admission/events.jsonl; ADMISSION_NOTIFY_CMD="<command>" is called with <type> <summary> for each one (no shell)
# LAN party mode (issue #75, DESIGN.md 14.2): two players who both agreed reach each other's namespace on the party's ports (pool.yaml)
#   mesh host party [list]                 every consent and its state (active, waiting, refused, off), after a reconcile
#   mesh host party list --read-only --json   the same without reconciling first (the host console)
#   mesh host party reconcile              open the parties both sides agreed to, close the rest (the tick and every kick run it too)
#   mesh host party end <a> <b>            end a party: both consents deleted, the NetworkPolicies removed
#   mesh host watch [status]               the host's watcher (D6, docs/CONSOLE-MODES.md): its namespace, nodes and parties
#   mesh host watch init                   make `watch-host` (poc/watcher.py): needs a Ready node of trust own that is not the control plane
#   mesh host watch invite|leave <owner>   the host's half of a party with a game's owner (the owner accepts: party accept watch-host)
#   mesh host watch start <owner> [--follow <player>]   the host's spectator of <owner>'s game (needs the party; the image on the own node)
#   mesh host watch stop <owner>           remove that spectator
#   mesh host watch status --json --read-only   the host's parties and spectators, without reconciling (the host console)
#   mesh host watch frame <owner>          one JPEG of that spectator on stdout, through the API server (D7: the host's own views only)
#   mesh host watch down                   remove the watcher namespace and all in it; its parties close
#   mesh host game start <owner>           a Doom server (pod doom-server, UDP Service doom on 10666) in <owner>'s namespace, on their node (#102)
#   mesh host game stop <owner>            remove it: everyone in that game is out
#   mesh party invite|accept <peer> [--ports P/UDP,...] --as <player>   (local simulation, like play) the player's own
#   mesh party leave [<peer>] | list --as <player>                      `edge-mesh party ...`, run on that player's machine
# The host console (docs/CONSOLE.md, issue #85): one local API in front of these verbs
#   mesh host console [--socket PATH] [--web 127.0.0.1:8090]
#                                          run its daemon in the foreground: a unix socket for this user only (<state>/console/api.sock,
#                                          or EMESH_CONSOLE_SOCK); reads, mutations as jobs; --web: the web console, loopback only
#   mesh host console url [--web ADDR]     a new web token (the old one dies), printed once in a link to open through an SSH tunnel
#   mesh host console rotate-token         a new web token, never printed: the old link dies
#   While it runs, the registry verbs typed here (request, approve, kick, reap, burn...) go through it: the same output and exit code,
#   one audit line each (<state>/console/audit.jsonl), 75 when it is busy. EMESH_DIRECT=1 runs them here instead; the tick and `panic`
#   always run here. Every mutating verb takes the engine's lock (<state>/mesh.lock), so two never run at once. Through the daemon a
#   verb runs with the daemon's environment (its unit), not this shell's: POOL_CONFIG, TOKEN_TTL and the like set here need EMESH_DIRECT=1.
# The CA key lives in .state/ca/ca.key: back it up; if you lose it you must re-issue every player.
set -eu
. "$(dirname "$0")/game-env.sh"
. "$(dirname "$0")/lib.sh"
usage() { sed -n '2,/^# The CA key/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 1 ] || usage

next_ip() { # first free Nebula IP from .5 up (1 lighthouse, 2 control plane, 3 and 4 are the PoC players), in the subnet of LH_NEB (stack.env,
  # the same one MESH_CIDR is derived from: cilium-node-guard.yaml refuses a CiliumNode InternalIP outside it)
  local net=${LH_NEB%.*} i=5; while [ -d "$STATE/bundles/ip-$i" ] || grep -qs "NODE_IP=$net.$i\$" "$STATE"/bundles/*/join.env; do i=$((i+1)); done; echo "$net.$i"
}

party_sync() { # the host's half of a party: open what both agreed to, close the rest (poc/party.py); prints only what changed
  python3 "$POC/party.py" reconcile --quiet --config "${POOL_CONFIG:-$POC/pool.yaml}" --bundles "$STATE/bundles" \
    --nebula-cert "$CACHE/nebula-cert" --kc "$POC/kc" "$@"
}

# The outermost layer (docs/CONSOLE.md, "Jobs, locks and timeouts" and "Audit", issue #88). A registry verb goes to the console daemon when
# it runs (its socket exists) and EMESH_DIRECT is unset; the timer's tick and `panic` never do. Anything run here instead marks the whole
# process tree direct (a nested `mesh` never goes through the API: it would wait for its own parent's lock), takes the engine's lock when it
# mutates (the outermost `mesh` only; `panic` takes it inside admission.py, after writing its switch), and for a registry verb runs the verb
# in a child, then writes its audit line (not for the tick: its facts are in admission/events.jsonl). EMESH_AUDITED=1 tells the nested calls
# (a reap's kicks, an approve's invite) that the line is written already.
read -r class verb <<EOF
$(verb_class "$@")
EOF
case "$class" in registry|mutate)
  if [ "$class" = registry ] && [ -z "${EMESH_DIRECT:-}" ] && [ "$verb" != tick ] && [ "$verb" != panic ]; then
    sock="${EMESH_CONSOLE_SOCK:-$STATE/console/api.sock}"
    [ ! -S "$sock" ] || exec python3 "$POC/console/client.py" run --socket "$sock" --mesh "$0" -- "$@"
  fi
  export EMESH_DIRECT=1
  [ "$verb" = panic ] || mesh_lock
  if [ "$class" = registry ] && [ -z "${EMESH_AUDITED:-}" ] && [ "$verb" != tick ]; then
    export EMESH_AUDITED=1; t0=${EPOCHREALTIME:-$(date +%s)}; rc=0
    # Ctrl-C stops the verb (the child gets it from the terminal), not this layer: a half-done verb still leaves its line, and then this
    # layer dies by SIGINT too, so a shell loop around `mesh` stops as it would without the layer
    int=""; trap 'int=1' INT
    "$0" "$@" || rc=$?
    python3 "$POC/console/client.py" audit --state "$STATE" --verb "$verb" --started "${t0/,/.}" --exit "$rc" -- "$@" ||
      echo "warning: the audit line of '$verb' was not written ($STATE/console/audit.jsonl)" >&2
    trap - INT
    [ -z "$int" ] || kill -INT $$
    exit "$rc"
  fi
  export EMESH_AUDITED=1 ;;
esac

case "$1 ${2:-}" in
  "host init") HOST_ONLY=1 "$UP" && record_game ;;   # the game's RUNTIME, CNI and TAINT go to .state/game.env (lib.sh)
  "host invite")
    name="${3:-}"; [ -n "$name" ] || usage; ttl=2h; trust=friends; shift 3
    # the name becomes a node name, a certificate name and a directory (the same rule as admission.py)
    printf '%s' "$name" | grep -Eqx '[a-z][a-z0-9-]{1,19}' && [ "$(printf '%s' "$name" | wc -l)" -eq 0 ] || { echo "invalid name '$name': 2 to 20 characters, a-z, 0-9 and '-', starting with a letter"; exit 2; }
    case "$name" in watch-host|host) echo "invalid name '$name': reserved for the host's watcher (docs/CONSOLE-MODES.md, D6; a spectator is announced as watch-<name>)"; exit 2 ;; esac
    pub=""
    while [ $# -gt 0 ]; do case "$1" in --ttl) ttl="$2"; shift 2 ;; --trust) trust="$2"; shift 2 ;; --pub) pub="$2"; shift 2 ;; *) usage ;; esac; done
    case "$trust" in friends|public) ;; *) echo "trust must be friends or public (own is for your own machines)"; exit 2 ;; esac
    [ ! -d "$STATE/bundles/$name" ] || { echo "a player called $name already exists"; exit 3; }
    game_mismatch || exit 2
    # the player's kubeconfig token lives exactly as long as the certificate (the lease); the TokenRequest API refuses less than 10 minutes, and the token is counted from the certificate's end after the invite's own seconds: 11m
    secs=$(python3 "$POC/participant.py" seconds "$ttl" 2>/dev/null) || { echo "invalid --ttl '$ttl': 90s, 15m, 2h, 1h30m"; exit 2; }
    [ "$secs" -ge 660 ] || { echo "--ttl $ttl is too short: the player's kubeconfig token needs at least 11m (the TokenRequest API minimum is 10m, and the invite itself takes some seconds)"; exit 2; }
    # a namespace of that name that exists already is not handed over (a leftover, or somebody else's)
    [ -z "$(k get namespace "play-$name" --ignore-not-found -o name 2>/dev/null)" ] || { echo "a namespace play-$name exists already: pick another name"; exit 3; }
    # the player's own public key (the public page, docs/PUBLIC-PAGE.md: its puller leaves it in admission/pubkeys): the bundle then has no host.key
    [ -n "$pub" ] || { [ ! -f "$STATE/admission/pubkeys/$name.pub" ] || pub="$STATE/admission/pubkeys/$name.pub"; }
    if [ -n "$pub" ]; then
      python3 "$POC/page/seal.py" check-nebula "$pub" >/dev/null || { echo "invite refused: $pub is not one Nebula X25519 public key"; exit 2; }
      pub="$(cd "$(dirname "$pub")" && pwd)/$(basename "$pub")"
    fi
    IN_PUB="$pub" "$POC/issue.sh" "$name" "$(next_ip)" "$trust" "$ttl" || { rm -rf "$STATE/bundles/$name"; echo "invite failed: nothing was kept, fix the error above and run it again"; exit 1; }
    # the node guard (poc/node-guard.yaml): only issued names, at their Nebula IP, may register a Node
    age=$(guard_refresh_age)
    node_guard || { token_burn "$name" || true; rm -rf "$STATE/bundles/$name"; echo "invite failed: the node guard was not updated; nothing was kept"; exit 1; }
    # the player's namespace and a kubeconfig of their own in the bundle (poc/participant.py; node and user credentials apart)
    participant_up "$name" || { participant_down "$name" >/dev/null 2>&1 || true; token_burn "$name" || true; rm -rf "$STATE/bundles/$name"
      node_guard >/dev/null 2>&1 || true; echo "invite failed: the player's namespace or kubeconfig could not be made; nothing was kept"; exit 1; }
    # the guard is safe only if it is rewritten every minute while a name waits (docs/ADMISSION.md, "the life of a name"): say so when nothing did
    [ "$age" -le 90 ] || echo "note: nothing rewrote the node guard in the last 90 s; while invites are open run './mesh host reap' (or 'burn') every minute from a timer (docs/HOST-YOUR-OWN.md)" >&2
    echo "bundle: $STATE/bundles/$name  (send it privately; it holds the player's key and a join token that works until the node registers or 8 min pass)"
    echo "namespace: play-$name  (the bundle's kubeconfig works there only, until $ttl from now)" ;;
  "host players")
    json=""; ro=""; shift 2
    while [ $# -gt 0 ]; do case "$1" in --json) json=1; shift ;; --read-only) ro=1; shift ;; *) usage ;; esac; done
    [ -n "$json" ] || printf '%-12s %-8s %s\n' PLAYER READY CERT-EXPIRES
    rows=""
    for b in "$STATE"/bundles/*/; do [ -d "$b" ] || continue; n=$(basename "$b"); case "$n" in lh|cp) continue ;; esac
      r=$(k get node "$n" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)
      e=$("$CACHE/nebula-cert" print -json -path "$b/host.crt" | python3 -c 'import sys,json;print(json.load(sys.stdin)[0]["details"]["notAfter"])')
      if [ -n "$json" ]; then rows="$rows$n ${r:-absent} $e
"; else printf '%-12s %-8s %s\n' "$n" "${r:-no}" "$e"; fi
      if [ -n "$r" ] && [ -z "$ro" ]; then token_burn "$n" || true; fi   # the node registered: its join token is not needed any more
    done
    # names are [a-z0-9-], Ready is True/False/Unknown/absent, the date has no space: one row, three words
    [ -z "$json" ] || printf '%s' "$rows" | python3 -c 'import sys,json;print(json.dumps([dict(zip(("name","ready","cert_expires"),l.split())) for l in sys.stdin if l.strip()]))'
    if [ -z "$ro" ] && ! node_guard >/dev/null 2>&1; then   # on stderr with --json: stdout stays one JSON document
      if [ -n "$json" ]; then echo "warning: the node guard was not refreshed (run mesh host burn)" >&2
      else echo "warning: the node guard was not refreshed (run mesh host burn)"; fi
    fi ;;
  "host burn")
    n=0
    for b in "$STATE"/bundles/*/; do p=$(basename "$b"); case "$p" in lh|cp) continue ;; esac
      if k get node "$p" >/dev/null 2>&1 && token_burn "$p"; then n=$((n+1)); fi
    done
    # and the node guard drops every issued name whose token expired unused (lib.sh guard_names)
    node_guard >/dev/null 2>&1 || echo "warning: the node guard was not refreshed (run mesh host burn again)"
    echo "burned $n" ;;
  "host revoke")
    name="${3:-}"; [ -n "$name" ] || usage
    "$POC/revoke.sh" "$name" ;;
  "host kick")
    name="${3:-}"; [ -n "$name" ] || usage
    k delete serviceaccount user -n "play-$name" --ignore-not-found >/dev/null 2>&1 || true   # the player's API token dies first
    k cordon "$name" >/dev/null 2>&1 || true
    k drain "$name" --ignore-daemonsets --delete-emptydir-data --force --timeout=30s >/dev/null 2>&1 || true
    "$POC/revoke.sh" "$name"
    machine_rm "$name"
    rc=0; participant_down "$name" || rc=$?
    party_sync 2>/dev/null || true   # a party with this player ends now, not at the next tick
    [ "$rc" = 0 ] || { echo "kick $name: the namespace play-$name is not gone yet (still terminating, or the API did not answer): run it again"; exit 4; } ;;
  "host activity")
    # active (exit 0): the player's Node is Ready and has a workload; "idle: <why>" (exit 1); the API did not answer (exit 2). The tick's idle kick.
    name="${3:-}"; [ -n "$name" ] || usage
    nodes=$(k get nodes -o json 2>/dev/null) || { echo "unknown: the API did not answer"; exit 2; }
    pods=$(k get pods -A -o json 2>/dev/null) || { echo "unknown: the API did not answer"; exit 2; }
    printf '{"nodes": %s, "pods": %s}' "$nodes" "$pods" | python3 "$POC/participant.py" activity "$name" ;;
  "host refresh")
    name="${3:-}"; [ -n "$name" ] || usage
    [ -n "${LH_EXTERNAL:-}" ] && [ "$name" = lh ] && { echo "the lighthouse is external: use poc/lighthouse-vps.sh sync"; exit 2; }
    old=$(cat "$STATE/bundles/$name/config.yml" 2>/dev/null || true)
    CONFIG_ONLY=1 "$POC/issue.sh" "$name" x x x >/dev/null || exit $?
    if [ "$old" = "$(cat "$STATE/bundles/$name/config.yml")" ]; then echo "refresh $name: unchanged"; exit 0; fi
    # a changed `stats`, `listen` or `relay` section needs a restart (on cp: k3s stopped first, started again once nebula1 is back); anything else
    # is read on SIGHUP. `relay` restarts so that turning the relay on never depends on what Nebula re-reads (lighthouse-vps.sh deploy does the same)
    if [ "$(printf '%s\n' "$old" | grep -E '^(stats|listen|relay):' || true)" = "$(grep -E '^(stats|listen|relay):' "$STATE/bundles/$name/config.yml" || true)" ]; then
      nebula_reload "$name" && echo "refresh $name: config applied (nebula reloaded)"
    else
      nebula_restart "$name" && echo "refresh $name: config applied (nebula restarted: stats, listen or relay changed)"
    fi ;;
  "host down") "$POC/down.sh" ;;
  "host console")
    shift 2
    case "${1:-}" in   # the web token is made here only, never through the API: a stolen token cannot mint the next one
      url|rotate-token) sub="$1"; shift; exec python3 "$POC/console/server.py" "$sub" --state "$STATE" "$@" ;;
    esac
    exec python3 "$POC/console/server.py" serve --state "$STATE" --mesh "$POC/mesh" "$@" ;;
  "host request"|"host waitlist"|"host approve"|"host reject"|"host leases"|"host reap"|"host admission-status"|"host auto"|"host panic"|"host bundle"|"host admission-metrics")
    sub="$2"; shift 2; case "$sub" in admission-status) sub=status ;; admission-metrics) sub=metrics ;; esac
    lock=""; [ "$verb" != panic ] || lock="--engine-lock=$STATE/mesh.lock"   # panic: the switch first, then the engine's lock (admission.py)
    rc=0; python3 "$POC/admission.py" --state "$STATE/admission" --config "${POOL_CONFIG:-$POC/pool.yaml}" --mesh "$POC/mesh" ${lock:+"$lock"} "$sub" "$@" || rc=$?
    # the tick also reconciles the parties (a consent made since the last one, a lease that ended); its own result is the tick's
    if [ "$sub ${1:-}" = "auto --once" ]; then party_sync 2>/dev/null || true; fi
    exit "$rc" ;;
  "host party")
    sub="${3:-list}"; shift; shift; [ $# -eq 0 ] || shift
    case "$sub" in list|reconcile|end) ;; *) usage ;; esac
    python3 "$POC/party.py" "$sub" "$@" --config "${POOL_CONFIG:-$POC/pool.yaml}" --bundles "$STATE/bundles" \
      --nebula-cert "$CACHE/nebula-cert" --kc "$POC/kc" ;;
  "host game")
    sub="${3:-}"; owner="${4:-}"
    printf '%s' "$owner" | grep -Eqx '[a-z][a-z0-9-]{1,19}' && [ "$(printf '%s' "$owner" | wc -l)" -eq 0 ] && [ "$owner" != watch-host ] ||
      { echo "usage: mesh host game start|stop <owner>"; exit 2; }
    ns="play-$owner"
    [ -n "$(k get namespace "$ns" --ignore-not-found -o name)" ] || { echo "no player $owner (namespace $ns)"; exit 3; }
    case "$sub" in
      start)
        [ -z "$(k get pod doom-server -n "$ns" --ignore-not-found -o name)" ] || { echo "game: $owner's server runs already"; exit 0; }
        img=$("$POC/doom/build.sh" --name) || exit 1
        "$POC/doom/pod.sh" server "$img" | k apply -n "$ns" -f - >/dev/null &&
          { [ -n "$(k get service doom -n "$ns" --ignore-not-found -o name)" ] || k expose pod doom-server -n "$ns" --name doom --port 10666 --protocol UDP >/dev/null; } || exit 1
        echo "game: $owner's server starting (pod doom-server, Service doom 10666/UDP in $ns; the image must be on $owner's node)" ;;
      stop)
        k delete pod doom-server -n "$ns" --ignore-not-found --wait=false >/dev/null && k delete service doom -n "$ns" --ignore-not-found >/dev/null || exit 1
        echo "game: $owner's server stopped" ;;
      *) echo "usage: mesh host game start|stop <owner>"; exit 2 ;;
    esac ;;
  "host watch")
    sub="${3:-status}"; owner="${4:-}"; w=watch-host; WD="$STATE/watch"
    case "$sub" in
      init)
        nodes=$(k get nodes -o json | python3 "$POC/watcher.py" nodes) || exit 3
        k apply -f - <"$POC/watcher-policy.yaml" >/dev/null || exit 1
        python3 "$POC/watcher.py" manifests --config "${POOL_CONFIG:-$POC/pool.yaml}" | k apply -f - >/dev/null || exit 1
        echo "watcher: namespace $w ready; its pods run on: $(echo $nodes)" ;;
      status)
        if [ "${4:-}" = --json ]; then   # --json --read-only: only reads (party list --read-only, get pods): the host console's view
          [ "${5:-}" = --read-only ] || usage
          python3 "$POC/watcher.py" status --kc "$POC/kc" --parties "$(python3 "$POC/party.py" list --read-only --json --config "${POOL_CONFIG:-$POC/pool.yaml}" \
            --bundles "$STATE/bundles" --nebula-cert "$CACHE/nebula-cert" --kc "$POC/kc")"; exit $?
        fi
        [ -n "$(k get namespace "$w" --ignore-not-found -o name)" ] || { echo "watcher: none (mesh host watch init)"; exit 0; }
        echo "watcher: namespace $w; nodes it may use: $(k get nodes -o json | python3 "$POC/watcher.py" nodes 2>&1 | tr '\n' ' ')"
        python3 "$POC/party.py" list --config "${POOL_CONFIG:-$POC/pool.yaml}" --bundles "$STATE/bundles" \
          --nebula-cert "$CACHE/nebula-cert" --kc "$POC/kc" | awk -v w="$w" 'NR == 1 || $1 == w || $2 == w' ;;
      start|stop|frame)
        printf '%s' "$owner" | grep -Eqx '[a-z][a-z0-9-]{1,19}' && [ "$(printf '%s' "$owner" | wc -l)" -eq 0 ] && [ "$owner" != "$w" ] || { echo "usage: mesh host watch $sub <owner>"; exit 2; }
        pod="doom-watch-$owner"
        case "$sub" in
          start)
            follow="$owner"; [ "${5:-}" != --follow ] || follow="${6:-}"
            printf '%s' "$follow" | grep -Eqx '[a-z][a-z0-9-]{1,19}' && [ "$(printf '%s' "$follow" | wc -l)" -eq 0 ] || { echo "usage: mesh host watch start <owner> [--follow <player>]"; exit 2; }
            st=$(python3 "$POC/party.py" list --read-only --json --config "${POOL_CONFIG:-$POC/pool.yaml}" --bundles "$STATE/bundles" \
              --nebula-cert "$CACHE/nebula-cert" --kc "$POC/kc" | python3 -c 'import json,sys; o=sys.argv[1]; print(next((r["status"] for r in json.load(sys.stdin) if r["player"]=="watch-host" and r["peer"]==o), ""))' "$owner") || exit 1
            case "$st" in active:*) ;; *) echo "no party with $owner (${st:-none}): mesh host watch invite $owner, then $owner accepts watch-host"; exit 3 ;; esac
            [ -z "$(k get pod "$pod" -n "$w" --ignore-not-found -o name)" ] || { echo "a spectator of $owner runs already: mesh host watch stop $owner"; exit 3; }
            img=$("$POC/doom/build.sh" --name) || exit 1
            mkdir -p "$WD"; chmod 700 "$WD"; tok=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
            (umask 077; printf '%s\n' "$tok" >"$WD/$owner.token")
            WATCH_TOKEN="$tok" "$POC/doom/pod.sh" watcher "$img" "$owner" host "$follow" | k apply -n "$w" -f - >/dev/null || { rm -f "$WD/$owner.token"; exit 1; }
            echo "watcher: spectator of $owner's game, following $follow (pod $pod in $w; frames: mesh host watch frame $owner)" ;;
          stop)
            k delete pod "$pod" -n "$w" --ignore-not-found --wait=false >/dev/null || exit 1; rm -f "$WD/$owner.token"; echo "watcher: stopped the spectator of $owner" ;;
          frame)
            [ -s "$WD/$owner.token" ] || { echo "no spectator of $owner (mesh host watch start $owner)" >&2; exit 3; }
            python3 "$POC/watcher.py" frame --kc "$POC/kc" --pod "$pod" --token-file "$WD/$owner.token" ;;
        esac ;;
      invite|leave)
        printf '%s' "$owner" | grep -Eqx '[a-z][a-z0-9-]{1,19}' && [ "$(printf '%s' "$owner" | wc -l)" -eq 0 ] && [ "$owner" != "$w" ] || { echo "usage: mesh host watch $sub <owner>"; exit 2; }
        [ -n "$(k get namespace "$w" --ignore-not-found -o name)" ] || { echo "no watcher: run mesh host watch init first"; exit 3; }
        if [ "$sub" = invite ]; then
          printf 'apiVersion: v1\nkind: ConfigMap\nmetadata: {name: party-%s, namespace: %s, labels: {edge-mesh/party-consent: "yes"}}\ndata: {peer: "%s", ports: ""}\n' \
            "$owner" "$w" "$owner" | k apply -f - >/dev/null || exit 1
          echo "watcher: asked $owner; the party opens when $owner runs: edge-mesh party accept $w"
        else
          k delete configmap "party-$owner" -n "$w" --ignore-not-found >/dev/null || exit 1; echo "watcher: left $owner"
        fi
        party_sync ;;
      down)
        k delete namespace "$w" --ignore-not-found --wait=true --timeout=120s >/dev/null || exit 4
        rm -rf "$WD"; party_sync; echo "watcher: removed" ;;
      *) usage ;;
    esac ;;
  "party invite"|"party accept"|"party leave"|"party list")
    verb="$2"; shift 2; as=""; args=""
    while [ $# -gt 0 ]; do case "$1" in --as) as="${2:-}"; shift 2 ;; *) args="$args $1"; shift ;; esac; done
    [ -d "$STATE/bundles/$as" ] && [ -n "$as" ] || { echo "mesh party $verb ... --as <player>: a player of this game"; exit 2; }
    # shellcheck disable=SC2086 # the arguments are a name and a port list, checked again by edge-mesh
    dx "$as" edge-mesh party "$verb" $args ;;
  "play "*)
    name="$2"; [ -d "$STATE/bundles/$name" ] || { echo "no bundle for $name: run mesh host invite $name"; exit 3; }
    ip=$(grep ^NODE_IP= "$STATE/bundles/$name/join.env" | cut -d= -f2); last=${ip##*.}
    new_container "$name" "172.31.0.$((last + 100))"
    dx "$name" edge-mesh join /bundle --accept-golden-rule ;;
  *) usage ;;
esac
